# Agente loopback (la URL debe conservar 127.0.0.1)
VITE_INSTAGRAM_AGENT_URL=http://127.0.0.1:8765
# URL HTTPS real donde se publicara el instalador firmado. Sin valor, la web no muestra un enlace ficticio.
VITE_INSTAGRAM_AGENT_INSTALLER_URL=
# Solo para una copia local sin instalador: carpeta mostrada en la guia de inicio.
VITE_INSTAGRAM_AGENT_SOURCE_PATH=D:\WebFelipe\mi-pagina-web\local_tools\instagram_exporter

# Solo al ejecutar el agente en desarrollo
INSTAGRAM_AGENT_PORT=8765
INSTAGRAM_AGENT_ORIGINS=http://localhost:5173,https://masanes.cl,https://www.masanes.cl
# INSTAGRAM_AGENT_RUNTIME=D:\ruta\controlada\runtime\instagram_exporter
